---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AuthCard from '@/components/admin/AuthCard.astro';

export const prerender = false;

let flash: { type: 'ok' | 'erreur'; text: string } | null = null;
if (Astro.url.searchParams.get('erreur') === 'acces') flash = { type: 'erreur', text: 'Ce compte n’a pas accès à l’espace admin.' };
if (Astro.url.searchParams.get('statut') === 'deconnecte') flash = { type: 'ok', text: 'Vous êtes déconnecté.' };

if (Astro.request.method === 'POST' && Astro.locals.supabase) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const { error } = await Astro.locals.supabase.auth.signInWithPassword({ email, password });
  // Étape 2 : code de l'application d'authentification (ou sa mise en place).
  if (!error) return Astro.redirect('/admin/verification', 303);
  flash = { type: 'erreur', text: 'E-mail ou mot de passe incorrect.' };
}
---

<AdminLayout title="Connexion" auth>
  <AuthCard title="Connexion" intro="Accès réservé à l’équipe de SKM La Fabrik." flash={flash}>
    <form method="post">
      <label>
        E-mail
        <input type="email" name="email" autocomplete="username" required />
      </label>
      <label>
        Mot de passe
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      <button class="bouton or" type="submit">Continuer</button>
    </form>
  </AuthCard>
</AdminLayout>
