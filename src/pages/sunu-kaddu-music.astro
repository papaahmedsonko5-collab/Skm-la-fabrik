---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Carousel from '@/components/Carousel.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import logoSk from '@/assets/brand/logo-sunu-kaddu.png';
import { photos, studioPhotos } from '@/data/photos';
import { heritage, label, productions, scenes, sunuTapeArtists } from '@/data/music';
import { offresArtistes, tarifsSource } from '@/data/offres';
import { rff } from '@/data/rff';
import afDc2dk from '@/assets/photos/affiches/dc2dk.jpg';
import afFilm from '@/assets/photos/affiches/film-showcase-concert.jpg';
import afJokko from '@/assets/photos/affiches/jokko-2-casablanca-2015.jpg';
import afJustLive from '@/assets/photos/affiches/just-live-2021.jpg';
import afOb10 from '@/assets/photos/affiches/onebeat-10-2022.jpg';
import afObNy from '@/assets/photos/affiches/onebeat-new-york-2012.jpg';
import afObX from '@/assets/photos/affiches/onebeat-x.jpg';
import afSlam from '@/assets/photos/affiches/slamoualeykum-rufisquois.jpg';
import afXShow from '@/assets/photos/affiches/the-x-show.jpg';

const pad = (n: number) => String(n).padStart(2, '0');

// Sommaire du hero : chaque entrée renvoie à une section numérotée de la page.
const sommaire = [
  { num: '03', titre: 'Face A · Face B', meta: 'Le catalogue', href: '#t-catalogue' },
  { num: '05', titre: 'Sunu Tape', meta: 'Compilation, 23 titres', href: '#t-tape' },
  { num: '06', titre: 'Le studio', meta: 'Les formules', href: '#studio' },
] as const;

// Affiches de scènes de PPS the Writah : légendes reprises uniquement du texte imprimé sur chaque affiche.
const affichesParcours = await Promise.all(
  [
    { src: afObNy, titre: 'New York is OneBeat', meta: 'Roulette et Autumn Bowl, Brooklyn · 5 et 6 octobre 2012', alt: 'Affiche OneBeat New York des 5 et 6 octobre 2012, présentant PPS, MC du Sénégal' },
    { src: afJokko, titre: 'Jokko #2', meta: 'L’Boulevard, stade du C.O.C, Casablanca · 17 septembre 2015', alt: 'Affiche du concert Jokko #2 au festival L’Boulevard 2015 à Casablanca, avec H-Name, Gee Bayss, Francoman et PPS the Writah' },
    { src: afJustLive, titre: 'Just Live, 10 ans de music', meta: 'Concert diffusé le 26 décembre 2021', alt: 'Affiche du concert Just Live, 10 ans de music de PPS the Writah, diffusé le 26 décembre 2021' },
    { src: afOb10, titre: 'OneBeat 10', meta: 'Taos et Albuquerque · du 17 octobre au 7 novembre 2022', alt: 'Affiche OneBeat 10, les 10 ans du programme, du 17 octobre au 7 novembre 2022' },
    { src: afObX, titre: 'OneBeat X', meta: 'Festival des 10 ans de OneBeat', alt: 'Affiche OneBeat X, festival des 10 ans réunissant 25 artistes de 19 pays' },
    { src: afFilm, titre: 'Film Showcase and Concert', meta: 'Maison de la Culture Douta Seck · Xuman, Diaw Diop et PPS', alt: 'Affiche du Film Showcase and Concert à la Maison de la Culture Douta Seck, avec Xuman, Diaw Diop et PPS' },
    { src: afSlam, titre: 'Slam’Oualeykum Rufisquois', meta: 'CC Maurice Gueye, Rufisque', alt: 'Affiche de Slam’Oualeykum Rufisquois au centre culturel Maurice Gueye, présenté par Sunu Kaddu' },
    { src: afXShow, titre: 'The X Show', meta: 'EFI de Rufisque', alt: 'Affiche du X Show de PPS the Ghost Writah à l’EFI de Rufisque' },
    { src: afDc2dk, titre: '#DC2DK', meta: 'Visuel du projet', alt: 'Visuel du projet #DC2DK' },
  ].map(async (a) => ({ ...a, full: (await getImage({ src: a.src, width: a.src.width, format: 'webp', quality: 90 })).src })),
);

const loge = [photos.rff25Loge1, photos.rff25Loge2, photos.rff25Loge4, photos.rff25Loge5, photos.rff25Loge6, photos.rff25Loge7, photos.rff25Loge8];
---

<BaseLayout
  overlayHeader
  title="Sunu Kaddu Music"
  description="Sunu Kaddu Music, le label fondé par PPS the Writah à Rufisque : studio Key I Am, productions, scènes, artistes de la Sunu Tape et formules studio pour les artistes."
>
  <section class="hero" aria-labelledby="titre-page">
    <div class="hero-lueur" aria-hidden="true"></div>
    <figure class="hero-photo">
      <Image
        src={photos.labelHero.src}
        alt={photos.labelHero.alt}
        widths={[480, 838, 1280, 1600, 1920]}
        sizes="(min-width: 64rem) 46vw, 100vw"
        quality={85}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="wrap hero-contenu">
      <div class="hero-texte">
        <p class="surtitre">Le label · Rufisque · Depuis 2014</p>
        <h1 id="titre-page" class="titre hero-titre">
          <span>Sunu</span> <span>Kaddu</span> <span class="accent">Music</span>
        </h1>
        <p class="sens citation">{label.meaning}</p>
        <p class="services">Composition · Enregistrement · Mixage · Mastering · Habillage sonore · Voix off</p>
        <div class="ctas">
          <Button href="/contact?objet=production">Produire un titre</Button>
          <Button href="#studio" variant="contour">Les formules studio</Button>
        </div>
      </div>
      <ol class="sommaire" aria-label="Sur cette page">
        {
          sommaire.map((s) => (
            <li>
              <a href={s.href}>
                <span class="sommaire-num">{s.num}</span>
                <span class="sommaire-titre">{s.titre}</span>
                <span class="sommaire-meta">{s.meta}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="theme-papier section vision" aria-labelledby="t-vision">
    <div class="wrap">
      <p class="index" data-reveal><span>01</span> La vision d’un leader&nbsp;: PPS the Writah</p>
      <h2 id="t-vision" class="grande-phrase" data-reveal>
        PPS fonde Sunu Kaddu, un espace conçu pour <mark>légitimer la créativité</mark> d’une jeunesse{' '}
        <mark>souvent ignorée par les structures formelles.</mark>
      </h2>
      <div class="vision-bas">
        <figure class="vision-photo" data-reveal>
          <Image src={photos.studio.src} alt={photos.studio.alt} widths={[480, 800, 1280, 1600, 1920]} sizes="(min-width: 56rem) 52vw, 100vw" quality={85} />
        </figure>
        <div class="vision-carte" data-reveal>
          <Image src={logoSk} alt="Logo Sunu Kaddu" width={96} height={96} class="vision-logo" />
          <p>{label.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="theme-anthracite section heritage" aria-labelledby="t-heritage">
    <div class="wrap">
      <div class="heritage-tete" data-reveal>
        <p class="index"><span>02</span> Formation &amp; technologie</p>
        <h2 id="t-heritage" class="titre titre-h2">Un centre d’excellence technique</h2>
      </div>
      <ol class="frise">
        {
          heritage.map((h) => (
            <li data-reveal>
              <span class="titre an" aria-hidden="true">{h.year}</span>
              <h3>
                <span class="sr-only">{h.year} : </span>
                {h.title}
              </h3>
              <p class="doux">{h.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="theme-sombre section catalogue" aria-labelledby="t-catalogue">
    <div class="wrap">
      <div class="catalogue-tete" data-reveal>
        <p class="index"><span>03</span> Le catalogue</p>
        <h2 id="t-catalogue" class="titre titre-h2">Productions majeures &amp; scènes emblématiques</h2>
      </div>
      <div class="faces">
        <div class="face" data-reveal>
          <div class="face-tete">
            <span class="face-lettre titre" aria-hidden="true">A</span>
            <div>
              <p class="face-meta">Face A</p>
              <h3 class="titre face-titre">Productions majeures</h3>
            </div>
          </div>
          <ol class="tracklist">
            {
              productions.map((p, i) => (
                <li>
                  <span class="n" aria-hidden="true">A{pad(i + 1)}</span>
                  <span class="t">{p.title}</span>
                  <span class="k">{p.kind}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="face" data-reveal>
          <div class="face-tete">
            <span class="face-lettre titre" aria-hidden="true">B</span>
            <div>
              <p class="face-meta">Face B</p>
              <h3 class="titre face-titre">Scènes emblématiques</h3>
            </div>
          </div>
          <ol class="tracklist">
            {
              scenes.map((s, i) => (
                <li>
                  <span class="n" aria-hidden="true">B{pad(i + 1)}</span>
                  <span class="t">{s.name}</span>
                  <span class="k">{s.place}</span>
                </li>
              ))
            }
          </ol>
          <p class="liens">
            <a class="lien-fleche" href="/projets/xaatim-ak-kallama">Xaatim ak Kallama <span aria-hidden="true">→</span></a>
            <a class="lien-fleche" href="/projets/loge-des-poetes">La Loge des Poètes <span aria-hidden="true">→</span></a>
            <a class="lien-fleche" href="/projets?categorie=Productions%20musicales">Toutes les productions <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
      <div class="affiches" data-reveal>
        <h3 class="titre titre-h3">Sur les affiches, d’ici et d’ailleurs</h3>
        <ul class="affiches-grille">
          {
            affichesParcours.map((a) => (
              <li>
                <a class="affiche" href={a.full} target="_blank" rel="noopener">
                  <Image src={a.src} alt={a.alt} widths={[360, 560, 900, 1260].filter((w) => w <= a.src.width)} sizes="(min-width: 64rem) 30vw, 50vw" quality={88} />
                </a>
                <p class="affiche-titre">{a.titre}</p>
                <p class="affiche-meta">{a.meta}</p>
              </li>
            ))
          }
        </ul>
        <p class="affiches-note">Touchez une affiche pour l’ouvrir en grand.</p>
      </div>
    </div>
  </section>

  <section class="theme-papier section ecouter" aria-labelledby="t-ecouter">
    <div class="wrap">
      <div class="ecouter-grid">
        <div class="ecouter-texte" data-reveal>
          <p class="index"><span>04</span> Voir &amp; écouter</p>
          <h2 id="t-ecouter" class="titre titre-h2">Sur scène</h2>
          <p class="chapeau">
            La playlist officielle du Rio Fresco Fest 2026 documente les cinq jours du festival, dont le plateau de la Loge des Poètes.
          </p>
          <p class="doux petit">Les liens d’écoute officiels du catalogue (Audiomack, plateformes de streaming) seront ajoutés dès leur confirmation par le label.</p>
        </div>
        <div class="ecouter-video" data-reveal>
          <VideoEmbed playlist={rff.playlistId} title="Playlist officielle du Rio Fresco Fest 2026" poster={photos.scene1.src} />
        </div>
      </div>
      <div class="loge" data-reveal>
        <p class="loge-legende surtitre">La Loge des Poètes · Rio Fresco Fest 2025</p>
        <Carousel label="Photos de la Loge des Poètes" tone="clair" itemWidth="clamp(13rem, 22vw, 18rem)">
          {
            loge.map((ph) => (
              <figure class="loge-photo">
                <Image src={ph.src} alt={ph.alt} widths={[320, 560, 1280, 1600, 1920]} sizes="(min-width: 64rem) 22vw, 60vw" />
              </figure>
            ))
          }
        </Carousel>
      </div>
    </div>
  </section>

  <section class="section sunutape" aria-labelledby="t-tape">
    <div class="wrap">
      <div class="tape-tete" data-reveal>
        <div>
          <p class="index"><span>05</span> Compilation · 2015</p>
          <h2 id="t-tape" class="titre titre-h2">Les voix de la Sunu Tape</h2>
        </div>
        <div class="tape-texte">
          <p>
            Pour le premier anniversaire de Key I Am, le label a offert une compilation gratuite de 23 titres. Elle a mis en lumière des artistes
            de Rufisque, Thiès, Dakar, Bargny et des zones rurales, de Keur Ndiaye Lo à Sangalkam.
          </p>
          <a class="lien-fleche" href="/projets/sunu-tape-vol-1">La fiche de la compilation <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="mur" aria-label="Artistes de la Sunu Tape Vol. 1" data-reveal>
        {sunuTapeArtists.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <section id="studio" class="theme-sombre section studio" aria-labelledby="t-studio">
    <div class="studio-lueur" aria-hidden="true"></div>
    <div class="wrap">
      <header class="studio-tete" data-reveal>
        <div>
          <p class="index"><span>06</span> Studio 360° · Artistes &amp; créatifs</p>
          <h2 id="t-studio" class="titre titre-h2">Les formules studio</h2>
        </div>
        <p class="doux">Création, mixage, mastering et promotion des talents locaux, au sein de SKM La Fabrik.</p>
      </header>
      <ul class="studio-photos" aria-label="Le Studio Key I Am" data-reveal>
        {
          studioPhotos.map((ph) => (
            <li>
              <Image src={ph.src} alt={ph.alt} widths={[400, 640, 960]} sizes="(min-width: 56rem) 30vw, 100vw" quality={85} />
            </li>
          ))
        }
      </ul>
      <p class="studio-lien"><a href="/a-propos#le-lieu">Voir tous les espaces de la Fabrik</a></p>
      <div class="offres">
        {
          offresArtistes.map((o, i) => (
            <section class:list={['offre', { phare: o.highlight }]} aria-labelledby={`f-${o.id}`} data-reveal>
              <p class="offre-num" aria-hidden="true">
                {pad(i + 1)}
              </p>
              <h3 id={`f-${o.id}`} class="titre">
                {o.name}
              </h3>
              <p class="pitch">{o.pitch}</p>
              <table>
                <caption class="sr-only">Formule {o.name}, prix en francs CFA</caption>
                <tbody>
                  {o.lines.map((l) => (
                    <tr>
                      <th scope="row">{l.label}</th>
                      <td>{l.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))
        }
      </div>
      <div class="studio-pied">
        <p class="doux">{tarifsSource}</p>
        <Button href="/contact?objet=production">Réserver le studio</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .affiches {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .affiches h3 {
    margin-bottom: 1.25rem;
  }
  .affiche {
    display: block;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .affiche :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease);
  }
  .affiche:hover :global(img) {
    transform: scale(1.02);
  }
  .affiches-grille {
    columns: 3 9.5rem;
    column-gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .affiches-grille li {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  .affiche-titre {
    margin-top: 0.6rem;
    font-weight: 600;
  }
  .affiche-meta {
    font-size: 0.875rem;
    opacity: 0.75;
  }
  .affiches-note {
    font-size: 0.875rem;
    opacity: 0.75;
  }
  .studio-photos {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .studio-photos img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }
  .studio-lien {
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .studio-lien a {
    color: var(--c-or);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 40rem) {
    .studio-photos {
      grid-template-columns: 1fr 1fr;
    }
    .studio-photos li:first-child {
      grid-column: 1 / -1;
    }
  }
  .section {
    padding-block: clamp(5rem, 3rem + 6vw, 7.5rem);
  }

  /* Repères numérotés (repris de l'accueil) */
  .index {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .index span {
    font-family: var(--f-titre);
    font-size: 1.25rem;
    letter-spacing: 0;
    color: var(--accent);
  }

  /* Hero : noir de salle de concert, photo de scène fondue, lueur or et terracotta */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(100svh, 56rem);
    padding-block: calc(4.75rem + clamp(3rem, 2rem + 4vw, 6rem)) clamp(2.5rem, 2rem + 2vw, 4rem);
    background: var(--c-noir);
    color: var(--c-papier);
    --accent: var(--c-or);
    --soft: var(--c-pierre);
  }
  .hero-lueur {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(48rem 40rem at 78% 30%, rgb(201 161 59 / 0.22), transparent 70%),
      radial-gradient(40rem 30rem at 10% 100%, rgb(224 102 44 / 0.16), transparent 70%);
    pointer-events: none;
  }
  .hero-photo {
    position: absolute;
    z-index: -1;
    top: calc(4.75rem + 2rem);
    right: var(--gutter);
    bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    width: min(42%, 40rem);
    margin: 0;
    overflow: hidden;
  }
  @media (min-width: 64.01rem) {
    .hero-contenu {
      padding-right: calc(min(42vw, 40rem) + 2.5rem);
    }
  }
  .hero-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .hero-contenu {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .hero-texte {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    max-width: 52rem;
  }
  .hero-titre {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    font-size: clamp(3.75rem, 1.4rem + 9.5vw, 11rem);
    line-height: 0.86;
  }
  .hero-titre span:last-child {
    flex-basis: 100%;
  }
  .sens {
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2.125rem);
    color: var(--c-terracotta);
  }
  .services {
    max-width: 34rem;
    font-size: var(--t-small);
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--c-pierre-claire);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .sommaire {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-ligne-sombre);
  }
  .sommaire li + li {
    border-left: 1px solid var(--c-ligne-sombre);
  }
  .sommaire a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.15rem 1rem;
    align-items: baseline;
    min-height: 2.75rem;
    padding: 1.25rem 1.25rem 0.25rem;
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .sommaire li:first-child a {
    padding-left: 0;
  }
  .sommaire a:hover {
    background: rgb(255 255 255 / 0.04);
  }
  .sommaire-num {
    grid-row: span 2;
    font-family: var(--f-titre);
    font-size: 1.25rem;
    color: var(--c-or);
  }
  .sommaire-titre {
    font-family: var(--f-titre);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    line-height: 1.05;
    text-transform: uppercase;
    transition: color 0.25s;
  }
  .sommaire a:hover .sommaire-titre {
    color: var(--c-or);
  }
  .sommaire-meta {
    font-size: var(--t-micro);
    color: var(--c-pierre);
  }
  @media (max-width: 64rem) {
    .hero {
      min-height: 0;
      padding-top: 4.75rem;
    }
    .hero-photo {
      position: relative;
      inset: auto;
      z-index: auto;
      grid-row: 1;
      width: auto;
      margin-inline: var(--gutter);
      height: clamp(22rem, 62svh, 34rem);
    }
    .hero-photo :global(img) {
      object-position: 50% 15%;
    }
    .hero-contenu {
      grid-row: 2;
      margin-top: 2rem;
    }
  }
  @media (max-width: 40rem) {
    .sommaire {
      grid-template-columns: minmax(0, 1fr);
    }
    .sommaire li + li {
      border-left: 0;
      border-top: 1px solid var(--c-ligne-sombre);
    }
    .sommaire a,
    .sommaire li:first-child a {
      padding: 0.9rem 0;
    }
  }

  /* 01 · Vision : grande phrase surlignée */
  .grande-phrase {
    max-width: 66rem;
    font-family: var(--f-texte);
    font-size: clamp(1.625rem, 1.05rem + 2.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .grande-phrase mark {
    padding-inline: 0.05em;
    background: linear-gradient(transparent 60%, var(--c-or) 60%, var(--c-or) 94%, transparent 94%);
    color: inherit;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .vision-bas {
    display: grid;
