---
import { t, tt } from '@/lib/cms';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Carousel from '@/components/Carousel.astro';
import Marquee from '@/components/Marquee.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Stats from '@/components/Stats.astro';
import { blueprintStats, partners, rff2026Stats } from '@/data/site';
import { cycle } from '@/data/impact';
import { photos } from '@/data/photos';
import { poles } from '@/data/poles';
import logoRff from '@/assets/brand/logo-rio-fresco-fest.png';
import logoSk from '@/assets/brand/logo-sunu-kaddu.png';
import { sortNews } from '@/lib/content';

const news = sortNews(await getCollection('actualites', ({ data }) => !data.draft));

// Ordre éditorial du carrousel : les projets phares d'abord, puis le reste du portfolio.
const ordre = ['rio-fresco-fest-2026', 'sunu-tape-vol-1', 'handischool-day', 'onebeat-senegal', 'loge-des-poetes', 'set-setal'];
const projets = (await getCollection('projets')).sort((a, b) => {
  const ia = ordre.indexOf(a.id);
  const ib = ordre.indexOf(b.id);
  return (ia === -1 ? ordre.length : ia) - (ib === -1 ? ordre.length : ib) || a.data.title.localeCompare(b.data.title, 'fr');
});

const etapes = [
  { titre: cycle[0], href: '/activites#formation', lien: 'Nos formations', photo: photos.formation, texte: 'Apprentissage pratique aux métiers de l’audiovisuel, du son, du graphisme et de la communication digitale.' },
  { titre: cycle[1], href: '/sunu-kaddu-music', lien: 'Le label', photo: photos.studio, texte: 'Le studio 360 Key I Am et le label Sunu Kaddu Music : composition, enregistrement, mixage, mastering.' },
  { titre: cycle[2], href: '/rio-fresco-fest', lien: 'Le festival', photo: photos.rffFoule, texte: 'Rio Fresco Fest, Loge des Poètes, Rufisque en Live : des scènes pour les talents révélés.' },
  { titre: cycle[3], href: '/impact', lien: 'Notre impact', photo: photos.setSetal, texte: 'Inclusion, éducation, réinsertion et environnement : la culture au service du territoire.' },
] as const;
---

<BaseLayout overlayHeader>
  <section class="hero" aria-labelledby="accroche">
    <div class="hero-lueur" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-texte">
        <p class="surtitre">{t('accueil.hero.surtitre')}</p>
        <h1 id="accroche" class="titre hero-titre" set:html={tt('accueil.hero.titre')} />
        <p class="hero-chapeau">{t('accueil.hero.chapeau')}</p>
        <div class="hero-actions">
          <Button href="/a-propos">Découvrir La Fabrik</Button>
          <Button href="/contact?objet=partenariat" variant="contour">Devenir partenaire</Button>
        </div>
      </div>
      <figure class="hero-photo">
        <Image
          src={photos.p26Hero.src}
          alt={photos.p26Hero.alt}
          widths={[640, 960, 1280, 1600, 2160]}
          sizes="(min-width: 56rem) 85vw, 100vw"
          quality={88}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
    <div class="wrap">
      <ul class="cartes" aria-label="Accès directs">
        <li>
          <a class="carte carte-or" href="/contact?objet=partenariat">
            <span class="carte-meta">Rio Fresco Fest · Édition 2027</span>
            <span class="carte-titre">Soutenir la prochaine édition</span>
            <span class="carte-fleche" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a class="carte carte-papier" href="/sunu-kaddu-music#studio">
            <span class="carte-meta">Studio Sunu Kaddu</span>
            <span class="carte-titre">Enregistrer, mixer, masteriser</span>
            <span class="carte-fleche" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a class="carte carte-ligne" href="/activites#formation">
            <span class="carte-meta">Formation</span>
            <span class="carte-titre">Apprendre les métiers de l’image et du son</span>
            <span class="carte-fleche" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <Marquee items={['Nul n’entre ici s’il n’est créatif', 'Formation', 'Production', 'Événementiel', 'Festivals', 'Communauté', 'Chaque pas raconte une histoire']} />

  <section class="theme-papier section manifeste" aria-labelledby="qui">
    <div class="wrap">
      <p class="index" data-reveal><span>01</span> Manifeste</p>
      <h2 id="qui" class="manifeste-texte" data-reveal>
        Plus qu’un studio, <mark>un moteur de transformation.</mark> Nous formons les jeunes de Rufisque aux métiers des arts, de
        l’audiovisuel et du digital, nous produisons leurs œuvres et nous les portons sur scène. <mark>Nul n’entre ici s’il
        n’est créatif.</mark>
      </h2>
      <div class="manifeste-bas">
        <div class="manifeste-photo" data-reveal>
          <Image src={photos.communaute.src} alt={photos.communaute.alt} widths={[480, 800, 987, 1280, 1600, 1920]} sizes="(min-width: 56rem) 40vw, 100vw" quality={85} />
        </div>
        <div class="manifeste-carte" data-reveal>
          <blockquote>
            <p class="citation">
              « Nous avons créé SKM La Fabrik pour donner aux jeunes de Rufisque les outils de leur autonomie artistique et
              professionnelle. »
            </p>
            <footer>PPS the Writah, fondateur et directeur artistique</footer>
          </blockquote>
          <p>
            Une plateforme créative qui allie production multimédia, formation et services audiovisuels, tout en répondant aux
            besoins en contenus des structures locales.
          </p>
          <a class="lien-fleche" href="/a-propos">Notre histoire <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <Stats data={blueprintStats} limit={4} />
    </div>
  </section>

  <section class="theme-sombre section" aria-labelledby="poles">
    <div class="wrap">
      <SectionHead eyebrow="Nos cinq pôles" title="Ce que nous fabriquons" id="poles" link={{ href: '/activites', label: 'Toutes nos activités' }} />
      <ol class="poles">
        {
          poles.map((p) => (
            <li data-reveal>
              <a href={`/activites#${p.id}`}>
                <span class="num">{p.num}</span>
                <span class="titre nom">{p.title}</span>
                <span class="desc">{p.short}</span>
                <Image src={p.photo.src} alt="" widths={[200, 320, 1280, 1600, 1920]} sizes="10rem" class="vignette" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="theme-anthracite section" aria-labelledby="realisations">
    <div class="wrap">
      <SectionHead eyebrow="Projets & réalisations" title="Une décennie de bâtisseurs" id="realisations" link={{ href: '/projets', label: 'Voir tout le portfolio' }} />
      <div class="carrousel-projets">
        <Carousel label="Projets de SKM La Fabrik" itemWidth="clamp(17rem, 30vw, 25rem)">
          {projets.map((p) => <ProjectCard project={p} />)}
        </Carousel>
      </div>
    </div>
  </section>

  <section class="theme-papier section processus" aria-labelledby="processus">
    <div class="wrap">
      <div class="processus-tete" data-reveal>
        <p class="index"><span>02</span> Notre méthode</p>
        <h2 id="processus" class="titre titre-h2">Un cycle complet, du premier atelier à la scène.</h2>
      </div>
      <ol class="etapes">
        {
          etapes.map((e, i) => (
            <li class="etape" data-reveal>
              <div class="etape-photo">
                <Image src={e.photo.src} alt="" widths={[360, 640, 1280, 1600, 1920]} sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 45vw, 100vw" quality={85} />
                <span class="etape-num" aria-hidden="true">0{i + 1}</span>
              </div>
              <h3 class="titre titre-h3">{e.titre}</h3>
              <p>{e.texte}</p>
              <a class="lien-fleche" href={e.href}>
                {e.lien} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="theme-nuit section rff" aria-labelledby="rff">
    <div class="wrap rff-grid">
      <div class="rff-texte" data-reveal>
        <Image src={logoRff} alt="Rio Fresco Fest Rufisque" width={320} class="rff-logo" />
        <h2 id="rff" class="titre titre-h2">Héritages &amp; Horizons&nbsp;: bâtir ensemble l’avenir de Rufisque</h2>
        <p class="doux">
          Le projet phare de Sunu Kaddu&nbsp;: un festival annuel qui transforme Rufisque en village éphémère. Street food,
          conférences, concerts, mode, street art et jeux intergénérationnels.
        </p>
        <p class="rff-date">Édition 2026 · 10 au 14 juin · Boulodrome, Rufisque</p>
        <div class="hero-actions">
          <Button href="/rio-fresco-fest" style="--btn-ink: var(--c-nuit)">Découvrir le festival</Button>
          <Button href="/contact?objet=partenariat" variant="contour">Soutenir l’édition 2027</Button>
        </div>
      </div>
      <div class="rff-visuel" data-reveal>
        <Image src={photos.rffDigue.src} alt={photos.rffDigue.alt} widths={[480, 800, 1100, 1280, 1600, 1920]} sizes="(min-width: 64rem) 45vw, 100vw" />
        <div style="--stat-color: var(--c-orange)">
          <Stats data={rff2026Stats} size="moyen" />
        </div>
      </div>
    </div>
  </section>

  <section class="theme-papier section" aria-labelledby="label">
    <div class="wrap label">
      <div class="label-visuel" data-reveal>
        <Image src={photos.studio.src} alt={photos.studio.alt} widths={[480, 800, 1280, 1600, 1920]} sizes="(min-width: 64rem) 42vw, 100vw" />
      </div>
      <div class="label-texte" data-reveal>
        <div class="label-logo"><Image src={logoSk} alt="Sunu Kaddu" width={130} height={130} /></div>
        <p class="surtitre">Le label · Sunu Kaddu Music</p>
        <h2 id="label" class="titre titre-h2">« Notre Parole », en wolof.</h2>
        <p class="chapeau">
          Fondé par PPS the Writah, le label a marqué le hip-hop sénégalais&nbsp;: <em>Xaatim ak Kallama</em>, Meilleur Album
          aux Galsen Hip Hop Awards 2015, la compilation <em>Sunu Tape</em>, et un studio 360 opérationnel depuis 2014.
        </p>
        <p class="services">Composition · Enregistrement · Mixage · Mastering · Habillage sonore · Voix off</p>
        <div class="hero-actions">
          <Button href="/sunu-kaddu-music" style="--btn-bg: var(--c-encre); --btn-ink: var(--c-papier); --btn-bg-hover: var(--c-noir)">Explorer le label</Button>
          <Button href="/contact?objet=production" variant="contour" style="--btn-outline-hover: rgb(0 0 0 / 0.05)">Réserver le studio</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="theme-sombre section" aria-labelledby="impact">
    <div class="wrap">
      <SectionHead eyebrow="Impact communautaire" title="La culture au service du territoire" id="impact">
        <p class="doux impact-intro">
          La culture comme moteur d’éducation, de développement et de solidarité, au service de la jeunesse, de l’inclusion et
          de l’environnement de Rufisque.
        </p>
      </SectionHead>
      <div class="actions">
        {
          [
            { tag: 'Environnement', title: 'Set Setal', href: '/projets/set-setal', photo: photos.setSetal, text: 'Des centaines de jeunes mobilisés pour le nettoyage de la digue de Rufisque, avec la SONAGED.' },
            { tag: 'Inclusion', title: 'Handischool Day', href: '/projets/handischool-day', photo: photos.handischool, text: 'Un studio mobile pour les enfants atteints de trisomie 21 à l’école Le Petit Prince, et un don de 8 ordinateurs.' },
            { tag: 'Réinsertion', title: 'Fort B', href: '/projets/fort-b', photo: photos.fortB, text: 'Des ateliers d’écriture et d’expression pour des mineurs incarcérés, vers un retour dans la société.' },
          ].map((a, i) => (
            <a class:list={['action', { decale: i === 1 }]} href={a.href} data-reveal>
              <Image src={a.photo.src} alt="" widths={[400, 640, 1280, 1600, 1920]} sizes="(min-width: 64rem) 30vw, 100vw" />
              <span class="surtitre">{a.tag}</span>
              <span class="titre titre-h3">{a.title}</span>
              <span class="doux">{a.text}</span>
            </a>
          ))
        }
      </div>
      <div class="odd">
        <p>Objectifs de développement durable&nbsp;: <strong class="accent">ODD 4 · 8 · 10 · 11 · 17</strong></p>
        <a class="lien-fleche" href="/impact">Notre impact <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="theme-papier section" aria-labelledby="actus">
    <div class="wrap">
      <SectionHead title="Actualités &amp; événements" id="actus" link={{ href: '/actualites', label: 'Toutes les actualités' }} />
      <Carousel label="Dernières actualités" tone="clair" itemWidth="clamp(17rem, 32vw, 27rem)">
        {
          news.map((n) => (
            <article class="news">
              <a href={`/actualites/${n.id}`}>
                <Image src={n.data.cover} style={`object-position: ${n.data.coverPosition}`} alt="" widths={[400, 640, 1280, 1600, 1920]} sizes="(min-width: 64rem) 32vw, 85vw" />
                <span class="news-meta">
                  {n.data.type} · {n.data.period}
                </span>
                <h3 class="news-titre">{n.data.title}</h3>
              </a>
            </article>
          ))
        }
      </Carousel>
    </div>
  </section>

  <section class="theme-papier partenaires" aria-labelledby="partenaires">
    <div class="wrap">
      <h2 id="partenaires" class="surtitre">Ils nous ont fait confiance</h2>
      <ul>
        {partners.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Respiration plus généreuse entre les sections de l'accueil */
  .section {
    padding-block: clamp(5rem, 3rem + 6vw, 7.5rem);
  }

  /* Hero : titre à gauche, photo entière cadrée à droite */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: calc(4.75rem + clamp(2rem, 1rem + 3vw, 4rem)) clamp(3rem, 2rem + 3vw, 5rem);
    background: var(--c-noir);
    color: var(--c-papier);
    --accent: var(--c-or);
  }
  .hero-lueur {
    position: absolute;
    z-index: -1;
    top: -28rem;
    right: -22rem;
    width: 72rem;
    height: 72rem;
    background: radial-gradient(closest-side, rgb(201 161 59 / 0.3), rgb(224 102 44 / 0.08) 55%, transparent 78%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: center;
  }
  .hero-texte {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
  }
  .hero-texte .surtitre {
    margin-bottom: 1.5rem;
  }
  .hero-titre {
    font-size: clamp(2.75rem, 1.2rem + 4vw, 6rem);
    line-height: 0.92;
    text-wrap: balance;
  }
  .hero-chapeau {
    max-width: 32rem;
    margin-top: 1.75rem;
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--c-pierre-claire);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .hero-photo {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
  }
  .hero-photo :global(img) {
    display: block;
    width: 100%;
    height: clamp(26rem, 66svh, 42rem);
    object-fit: cover;
    object-position: 60% 35%;
  }
  .cartes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(2rem, 1rem + 2vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .carte {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    gap: 1.25rem 1rem;
    height: 100%;
    min-height: 9.5rem;
    padding: 1.5rem;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .carte-meta {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .carte-titre {
    align-self: end;
    font-family: var(--f-titre);
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .carte-fleche {
    align-self: end;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.3s var(--ease);
  }
  .carte:hover .carte-fleche {
    transform: translateX(5px);
  }
  .carte-or {
    background: var(--c-or);
    color: var(--c-noir);
  }
  .carte-or:hover {
    background: var(--c-or-vif);
  }
  .carte-papier {
    background: var(--c-papier);
    color: var(--c-encre);
  }
  .carte-papier:hover {
    background: #fff;
  }
  .carte-ligne {
    border: 1px solid var(--c-ligne-sombre);
    color: var(--c-papier);
  }
  .carte-ligne .carte-meta {
    color: var(--c-or);
  }
  .carte-ligne:hover {
    border-color: var(--c-or);
  }
  @media (max-width: 64rem) {
    .hero {
      padding-top: 5.75rem;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-photo {
      grid-column: 1;
      grid-row: 1;
    }
    .hero-photo :global(img) {
      height: clamp(18rem, 52svh, 30rem);
    }
    .hero-texte {
      grid-column: 1;
      grid-row: 2;
      margin: 2rem 0 0;
    }
  }
  @media (max-width: 56rem) {
    .cartes {
      grid-template-columns: minmax(0, 1fr);
    }
    .carte {
      min-height: 0;
    }
  }

  /* Repères numérotés des sections éditoriales */
  .index {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .index span {
    font-family: var(--f-titre);
    font-size: 1.25rem;
    letter-spacing: 0;
    color: var(--accent);
  }

  /* Manifeste */
  .manifeste-texte {
    max-width: 66rem;
    font-family: var(--f-texte);
    font-size: clamp(1.625rem, 1.05rem + 2.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .manifeste-texte mark {
    padding-inline: 0.05em;
    background: linear-gradient(transparent 60%, var(--c-or) 60%, var(--c-or) 94%, transparent 94%);
    color: inherit;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .manifeste-bas {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    align-items: stretch;
    margin-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
  }
  .manifeste-photo :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .manifeste-carte {
    position: relative;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin: 0;
    align-self: stretch;
    padding: clamp(1.75rem, 1rem + 2vw, 3rem);
    background: #fff;
  }
  blockquote {
    margin: 0;
  }
  blockquote footer {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--c-encre-douce);
  }
  @media (max-width: 56rem) {
    .manifeste-bas {
      grid-template-columns: minmax(0, 1fr);
    }
    .manifeste-carte {
      margin: 0;
    }
  }

  .poles {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .poles a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.1fr) 10rem;
    align-items: center;
    gap: 1rem 2.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .poles li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .poles a:hover {
    background: rgb(255 255 255 / 0.03);
  }
  .num {
    font-family: var(--f-titre);
    font-size: 1.375rem;
    color: var(--c-or);
  }
  .nom {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    line-height: 1;
    transition: color 0.3s;
  }
  .poles a:hover .nom {
    color: var(--c-or);
  }
  .desc {
    color: var(--soft);
    max-width: 30rem;
  }
  .vignette {
    width: 10rem;
    height: 6.5rem;
    object-fit: cover;
    filter: grayscale(0.6);
    transition: filter 0.4s;
  }
  .poles a:hover .vignette {
    filter: none;
  }
  @media (max-width: 56rem) {
    .poles a {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .desc {
      grid-column: 2;
    }
    .vignette {
      display: none;
    }
  }

  /* Carrousel des projets : cartes sur fond noir pour se détacher de l'anthracite */
  .carrousel-projets {
    --card-bg: var(--c-noir);
  }

