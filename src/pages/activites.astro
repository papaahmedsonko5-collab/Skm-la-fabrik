---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import PageIntro from '@/components/PageIntro.astro';
import SectionHead from '@/components/SectionHead.astro';
import { poles } from '@/data/poles';
import { offresEntreprises, tarifsSource } from '@/data/offres';

const themes = ['theme-sombre', 'theme-papier', 'theme-anthracite', 'theme-sombre', 'theme-papier'] as const;
---

<BaseLayout
  title="Nos activités"
  description="Formation, événementiel, festivals, production musicale et activités communautaires : les cinq pôles de SKM La Fabrik à Rufisque."
>
  <PageIntro
    eyebrow="Nos activités · Le moteur"
    title={'Cinq pôles,<br />une même <span class="accent">exigence.</span>'}
    lead="Former les talents, produire des contenus de haute qualité, faire vivre la scène et réinvestir dans la communauté : chaque pôle nourrit les autres."
  >
    <nav class="sommaire" aria-label="Les cinq pôles">
      {
        poles.map((p) => (
          <a href={`#${p.id}`}>
            <span>{p.num}</span> {p.title}
          </a>
        ))
      }
    </nav>
  </PageIntro>

  {
    poles.map((p, i) => (
      <section id={p.id} class:list={['pole', 'section', themes[i]]} aria-labelledby={`t-${p.id}`}>
        <div class:list={['wrap', 'pole-grid', { inverse: i % 2 === 1 }]}>
          <figure class="pole-photo" data-reveal>
            <Image src={p.photo.src} alt={p.photo.alt} widths={[480, 800, 1100]} sizes="(min-width: 64rem) 46vw, 100vw" />
            <span class="titre num" aria-hidden="true">{p.num}</span>
          </figure>
          <div class="pole-texte" data-reveal>
            <p class="surtitre">{p.kicker}</p>
            <h2 id={`t-${p.id}`} class="titre titre-h2">{p.title}</h2>
            <p class="chapeau doux">{p.text}</p>
            <dl>
              {p.items.map((it) => (
                <div>
                  <dt>{it.k}</dt>
                  <dd class="doux">{it.v}</dd>
                </div>
              ))}
            </dl>
            <div class="ctas">
              <Button href={p.cta.href}>{p.cta.label}</Button>
              <a class="lien-fleche" href={p.cta2.href}>
                {p.cta2.label} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="theme-blanc section" aria-labelledby="offre">
    <div class="wrap">
      <SectionHead eyebrow="Creative solutions · Entreprises & institutions" title="L’offre commerciale" id="offre">
        <p class="doux offre-intro">
          Pour les structures publiques, ONG, startups et entreprises qui souhaitent communiquer efficacement sur leurs projets
          et leurs impacts.
        </p>
      </SectionHead>
      <div class="offres">
        {
          offresEntreprises.map((o) => (
            <section class:list={['offre', { premium: o.highlight }]} aria-labelledby={`o-${o.id}`} data-reveal>
              <h3 id={`o-${o.id}`} class="titre">{o.name}</h3>
              <p class="pitch">{o.pitch}</p>
              <table>
                <caption class="sr-only">Prestations de la formule {o.name}, en francs CFA</caption>
                <tbody>
                  {o.lines.map((l) => (
                    <tr>
                      <th scope="row">{l.label}</th>
                      <td>{l.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))
        }
      </div>
      <div class="offre-pied">
        <p class="doux">{tarifsSource}</p>
        <Button href="/contact?objet=prestation" style="--btn-bg: var(--c-encre); --btn-ink: var(--c-papier); --btn-bg-hover: var(--c-noir)">Demander un devis</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sommaire {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .sommaire a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--c-ligne-sombre);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .sommaire a:hover {
    border-color: var(--c-or);
  }
  .sommaire span {
    color: var(--c-or);
  }
  .pole-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .inverse .pole-photo {
    order: 2;
  }
  @media (max-width: 56rem) {
    .pole-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .inverse .pole-photo {
      order: 0;
    }
  }
  .pole-photo {
    position: relative;
  }
  .pole-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .num {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.4rem 0.9rem;
    background: var(--accent);
    color: var(--c-noir);
    font-size: 1.75rem;
  }
  .theme-papier .num {
    background: var(--c-encre);
    color: var(--c-or);
  }
  .pole-texte {
    display: grid;
    gap: 1.5rem;
  }
  .theme-anthracite {
    --accent: var(--c-terracotta);
  }
  dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  dl > div {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-weight: 700;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 34rem) {
    dl > div {
      grid-template-columns: 1fr;
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }
  .theme-papier .ctas :global(.btn-plein) {
    --btn-bg: var(--c-encre);
    --btn-ink: var(--c-papier);
    --btn-bg-hover: var(--c-noir);
  }

  .offre-intro {
    max-width: 30rem;
  }
  .offres {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }
  .offre {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 2rem;
    background: var(--c-papier);
  }
  .offre h3 {
    font-size: 2.25rem;
  }
  .pitch {
    font-size: 0.9375rem;
    color: var(--c-encre-douce);
  }
  .premium {
    background: var(--c-encre);
    color: var(--c-papier);
  }
  .premium .pitch {
    color: var(--c-pierre-claire);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  th,
  td {
    padding: 0.75rem 0;
    border-top: 1px solid var(--c-ligne-claire);
    vertical-align: top;
  }
  .premium th,
  .premium td {
    border-color: var(--c-ligne-sombre);
  }
  th {
    text-align: left;
    font-weight: 400;
    padding-right: 1rem;
  }
  td {
    text-align: right;
    font-weight: 700;
    white-space: nowrap;
  }
  .offre-pied {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    font-size: 0.8125rem;
  }
</style>
