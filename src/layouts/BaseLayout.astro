---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { organizationJsonLd } from '@/lib/seo';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import archivoWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';

export interface Props {
  /** Titre de la page, sans le nom du site. Omettre pour l'accueil. */
  title?: string;
  description?: string;
  /** Image Open Graph absolue ou relative au site (1200×630 conseillé). */
  image?: string | undefined;
  tone?: 'fabrik' | 'rff';
  /** Données structurées supplémentaires propres à la page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Menu transparent sur la photo d'ouverture (pages à hero photo). */
  overlayHeader?: boolean;
}

const { title, description = site.description, image = '/og-default.jpg', tone = 'fabrik', jsonLd, noindex = false, overlayHeader = false } =
  Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(image, Astro.site);
const structured = [organizationJsonLd(Astro.site), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="fr" data-tone={tone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={tone === 'rff' ? '#0b1638' : '#0d0c0a'} />
    <link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    <script
      type="speculationrules"
      is:inline
      set:html={JSON.stringify({
        prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/api/*' } }] }, eagerness: 'moderate' }],
      })}
    />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header tone={tone} overlay={overlayHeader} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal } from '@/lib/reveal';
      initReveal();
    </script>
    {
      !noindex && (
        <script is:inline>
          (function () {
            // Compteur de visites sans cookie (voir la page Confidentialité).
            function compter() {
              try {
                fetch('/api/visite', {
                  method: 'POST',
                  keepalive: true,
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ chemin: location.pathname, provenance: document.referrer }),
                }).catch(function () {});
              } catch {
                // La mesure d’audience ne doit jamais gêner la page.
              }
            }
            if (navigator.webdriver) return;
            // Page préchargée en arrière-plan : on ne compte qu'à l'affichage réel.
            if (document.prerendering) document.addEventListener('prerenderingchange', compter, { once: true });
            else compter();
          })();
        </script>
      )
    }
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--c-or);
    color: var(--c-noir);
    font-weight: 700;
    text-decoration: none;
    transition: top 0.2s;
  }
  .skip:focus {
    top: 1rem;
  }
  main:focus {
    outline: none;
  }
</style>
