---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  /** Occupe deux colonnes et deux lignes dans la mosaïque. */
  large?: boolean;
  /** Catégorie, pour le filtre de la galerie. */
  categorie?: string;
}

interface Props {
  items: readonly GalleryItem[];
  label: string;
  /** Affiche un filtre par catégorie quand la galerie en compte plusieurs. */
  filtres?: boolean;
}
const { items, label, filtres = false } = Astro.props;
const categories = [...new Set(items.map((it) => it.categorie).filter((c): c is string => Boolean(c)))];
const avecFiltre = filtres && categories.length > 1;

const full = await Promise.all(items.map((it) => getImage({ src: it.src, width: Math.min(1920, it.src.width), format: 'webp', quality: 88 })));
---

<div class="gallery" data-gallery>
  {
    avecFiltre && (
      <div class="filtres" role="group" aria-label="Filtrer les photos par catégorie">
        <button type="button" data-filtre="" aria-pressed="true">
          Toutes <span>{items.length}</span>
        </button>
        {categories.map((c) => (
          <button type="button" data-filtre={c} aria-pressed="false">
            {c} <span>{items.filter((it) => it.categorie === c).length}</span>
          </button>
        ))}
      </div>
    )
  }
  <ul class="grid" aria-label={label}>
    {
      items.map((it, i) => (
        <li class:list={{ large: it.large }} data-categorie={it.categorie ?? ''}>
          <button type="button" data-open={i} data-full={full[i]?.src} data-alt={it.alt} aria-label={`Agrandir : ${it.alt}`}>
            <Image src={it.src} alt="" widths={[360, 560, 900, 1280, 1600]} sizes={it.large ? '(min-width: 64rem) 45vw, (min-width: 30rem) 90vw, 100vw' : '(min-width: 64rem) 25vw, (min-width: 30rem) 45vw, 100vw'} quality={82} />
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Visionneuse de photos">
    <figure>
      <img alt="" data-lb-img />
      <figcaption data-lb-caption></figcaption>
    </figure>
    <div class="controls">
      <button type="button" data-lb-prev aria-label="Photo précédente">←</button>
      <span data-lb-count aria-live="polite"></span>
      <button type="button" data-lb-next aria-label="Photo suivante">→</button>
      <button type="button" data-lb-close class="close">Fermer</button>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog');
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]');
    const caption = root.querySelector<HTMLElement>('[data-lb-caption]');
    const count = root.querySelector<HTMLElement>('[data-lb-count]');
    const tous = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-open]'));
    if (!dialog || !img || !caption || !count || tous.length === 0) return;
    // La visionneuse ne parcourt que les photos affichées par le filtre.
    let triggers = tous;

    const boutons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filtre]'));
    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        const cat = b.dataset['filtre'] ?? '';
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        tous.forEach((t) => {
          const li = t.closest('li');
          if (li) li.hidden = cat !== '' && li.dataset['categorie'] !== cat;
        });
        triggers = tous.filter((t) => !t.closest('li')?.hidden);
      }),
    );

    let index = 0;
    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      const t = triggers[index];
      if (!t) return;
      img.src = t.dataset['full'] ?? '';
      img.alt = t.dataset['alt'] ?? '';
      caption.textContent = t.dataset['alt'] ?? '';
      count.textContent = `${index + 1} / ${triggers.length}`;
    };

    tous.forEach((t) =>
      t.addEventListener('click', () => {
        show(triggers.indexOf(t));
        dialog.showModal();
      }),
    );
    root.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    root.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => triggers[index]?.focus());
  });
</script>

<style>
  .filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .filtres button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--c-ligne-sombre);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }
  .filtres button span {
    margin-left: 0.35rem;
    color: var(--c-pierre);
    font-weight: 400;
  }
  .filtres button[aria-pressed='true'] {
    border-color: var(--c-or);
    background: var(--c-or);
    color: var(--c-noir);
  }
  .filtres button[aria-pressed='true'] span {
    color: inherit;
  }
  .grid li[hidden] {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    grid-auto-rows: clamp(10rem, 8rem + 8vw, 14rem);
    grid-auto-flow: dense;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .large {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (max-width: 30rem) {
    .large {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
  li button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--c-anthracite-2);
    cursor: zoom-in;
    overflow: hidden;
  }
  li :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  li button:hover :global(img) {
    transform: scale(1.04);
  }
  .lightbox {
    width: min(100vw - 2rem, 80rem);
    max-height: calc(100vh - 2rem);
    padding: 0;
    border: 0;
    background: var(--c-noir);
    color: var(--c-papier);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }
  figure {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1rem 0;
  }
  figure img {
    width: 100%;
    max-height: calc(100vh - 10rem);
    object-fit: contain;
  }
  figcaption {
    font-size: 1rem;
    color: var(--c-pierre);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
  }
  .controls button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--c-ligne-sombre);
    background: transparent;
    font-size: 1.1rem;
    cursor: pointer;
  }
  .controls .close {
    margin-left: auto;
    padding: 0 1rem;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  [data-lb-count] {
    font-size: 0.9375rem;
    color: var(--c-pierre);
  }
</style>
