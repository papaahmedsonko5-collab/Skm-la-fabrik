---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  /** Occupe deux colonnes et deux lignes dans la mosaïque. */
  large?: boolean;
}

interface Props {
  items: readonly GalleryItem[];
  label: string;
}
const { items, label } = Astro.props;

const full = await Promise.all(items.map((it) => getImage({ src: it.src, width: 1600, format: 'webp' })));
---

<div class="gallery" data-gallery>
  <ul class="grid" aria-label={label}>
    {
      items.map((it, i) => (
        <li class:list={{ large: it.large }}>
          <button type="button" data-open={i} data-full={full[i]?.src} data-alt={it.alt} aria-label={`Agrandir : ${it.alt}`}>
            <Image src={it.src} alt="" widths={[360, 560, 900]} sizes="(min-width: 64rem) 25vw, 50vw" />
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Visionneuse de photos">
    <figure>
      <img alt="" data-lb-img />
      <figcaption data-lb-caption></figcaption>
    </figure>
    <div class="controls">
      <button type="button" data-lb-prev aria-label="Photo précédente">←</button>
      <span data-lb-count aria-live="polite"></span>
      <button type="button" data-lb-next aria-label="Photo suivante">→</button>
      <button type="button" data-lb-close class="close">Fermer</button>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog');
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]');
    const caption = root.querySelector<HTMLElement>('[data-lb-caption]');
    const count = root.querySelector<HTMLElement>('[data-lb-count]');
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-open]'));
    if (!dialog || !img || !caption || !count || triggers.length === 0) return;

    let index = 0;
    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      const t = triggers[index];
      if (!t) return;
      img.src = t.dataset['full'] ?? '';
      img.alt = t.dataset['alt'] ?? '';
      caption.textContent = t.dataset['alt'] ?? '';
      count.textContent = `${index + 1} / ${triggers.length}`;
    };

    triggers.forEach((t, i) =>
      t.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );
    root.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    root.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => triggers[index]?.focus());
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    grid-auto-rows: clamp(10rem, 8rem + 8vw, 14rem);
    grid-auto-flow: dense;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .large {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (max-width: 30rem) {
    .large {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
  li button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--c-anthracite-2);
    cursor: zoom-in;
    overflow: hidden;
  }
  li :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  li button:hover :global(img) {
    transform: scale(1.04);
  }
  .lightbox {
    width: min(100vw - 2rem, 80rem);
    max-height: calc(100vh - 2rem);
    padding: 0;
    border: 0;
    background: var(--c-noir);
    color: var(--c-papier);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }
  figure {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1rem 0;
  }
  figure img {
    width: 100%;
    max-height: calc(100vh - 10rem);
    object-fit: contain;
  }
  figcaption {
    font-size: 0.9375rem;
    color: var(--c-pierre);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
  }
  .controls button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--c-ligne-sombre);
    background: transparent;
    font-size: 1.1rem;
    cursor: pointer;
  }
  .controls .close {
    margin-left: auto;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  [data-lb-count] {
    font-size: 0.875rem;
    color: var(--c-pierre);
  }
</style>
