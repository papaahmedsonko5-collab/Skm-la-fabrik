---
interface Props {
  items: readonly string[];
}
const { items } = Astro.props;
const line = items.join(' ✦ ');
---

<div class="marquee" role="presentation">
  <p class="sr-only">{items.join('. ')}</p>
  <div class="track" aria-hidden="true">
    <span>{line} ✦&nbsp;</span>
    <span>{line} ✦&nbsp;</span>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid rgb(255 255 255 / 0.08);
    background: transparent;
    color: rgb(243 238 228 / 0.62);
  }
  .track {
    display: flex;
    width: max-content;
    animation: defile 40s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  span {
    padding: 0.22rem 0;
    white-space: pre;
    font-family: var(--f-texte);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    word-spacing: 0.5em;
  }
  @keyframes defile {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
