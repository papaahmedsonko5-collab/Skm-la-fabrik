---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Lecteur YouTube « à la demande » : rien n'est chargé depuis YouTube (ni
 * script, ni cookie) avant le clic du visiteur. Sans JavaScript, le bouton
 * reste un lien vers la vidéo ou la playlist.
 */
interface Props {
  /** Identifiant de playlist YouTube (list=…). */
  playlist?: string;
  /** Identifiant de vidéo YouTube (v=…). */
  video?: string;
  title: string;
  poster: ImageMetadata;
  /** Petite carte (grille de vidéos) : sans la mention sous le bouton. */
  compact?: boolean;
}
const { playlist, video, title, poster, compact = false } = Astro.props;

if (!playlist && !video) throw new Error('VideoEmbed : indiquez `playlist` ou `video`.');

const embed = playlist
  ? `https://www.youtube-nocookie.com/embed/videoseries?list=${encodeURIComponent(playlist)}&autoplay=1&rel=0`
  : `https://www.youtube-nocookie.com/embed/${encodeURIComponent(video ?? '')}?autoplay=1&rel=0`;
const watch = playlist
  ? `https://www.youtube.com/playlist?list=${encodeURIComponent(playlist)}`
  : `https://www.youtube.com/watch?v=${encodeURIComponent(video ?? '')}`;
---

<div class:list={['video', { compact }]} data-video data-embed={embed} data-title={title}>
  <Image quality={90} src={poster} alt={`Image d’aperçu : ${title}`} widths={[480, 800, 1200, 1280, 1600, 1920, 2560]} sizes="(min-width: 64rem) 60vw, 100vw" class="poster" />
  <a class="play" href={watch} target="_blank" rel="noopener" data-play>
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" focusable="false"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
    </span>
    <span class="label">Lire : {title}</span>
  </a>
  {!compact && <p class="note">La vidéo est hébergée par YouTube et ne se charge qu’après votre clic.</p>}
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const btn = box.querySelector<HTMLAnchorElement>('[data-play]');
    btn?.addEventListener('click', (ev) => {
      const src = box.dataset['embed'];
      if (!src) return;
      ev.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = box.dataset['title'] ?? 'Vidéo';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(frame);
      box.classList.add('is-playing');
      frame.focus();
    });
  }
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--c-noir);
    overflow: hidden;
  }
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }
  .play {
    position: absolute;
    left: 1.25rem;
    bottom: 3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--c-papier);
    font-weight: 700;
    text-decoration: none;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    background: var(--accent, var(--c-or));
    color: var(--c-noir);
    transition: transform 0.2s;
  }
  .play:hover .icon,
  .play:focus-visible .icon {
    transform: scale(1.06);
  }
  .label {
    max-width: 22rem;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }
  .compact .play {
    bottom: 1rem;
    left: 1rem;
    gap: 0.7rem;
  }
  .compact .icon {
    width: 3rem;
    height: 3rem;
  }
  .compact .label {
    font-size: 0.9375rem;
  }
  .note {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 0.9rem;
    font-size: 0.8125rem;
    color: var(--c-pierre-claire);
  }
</style>
