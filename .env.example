# URL publique du site (balises canoniques, sitemap, Open Graph)
SITE_URL=https://skm-la-fabrik.vercel.app

# Envoi des demandes du formulaire de contact via Resend (https://resend.com)
# Sans ces deux variables, le formulaire répond qu'il est temporairement indisponible.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=SKM La Fabrik <site@votre-domaine.sn>

# Espace d'administration (Supabase). La clé publiable (sb_publishable_…) est sans danger :
# les règles RLS de la base protègent les données. Ne jamais utiliser la clé « secret » ici.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Vercel > Settings > Git > Deploy Hooks : URL appelée par le bouton « Publier »
DEPLOY_HOOK_URL=
